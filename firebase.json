{
  "database": {
    "rules": "database.rules.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "firebase-debug.log",
      "*.bat",
      "*.cmd",
      "*.ps1",
      "*.exe",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/chatvista.html"
      }
    ]
  }
}
